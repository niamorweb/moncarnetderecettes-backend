  </head>
  <body>
    {{#each recipes}}
      <div class='recipe-page'>
        <header>
          <div class='img-container'>
            <img src='{{this.image_url}}' alt='{{this.name}}' />
          </div>

          <div class='header-content'>
            <span class='category-badge'>{{this.category.name}}</span>
            <h1>{{this.name}}</h1>

            <div class='badges-row'>
              <div class='info-badge'>
                <svg class='icon' viewBox='0 0 24 24'><circle
                    cx='12'
                    cy='12'
                    r='10'
                  ></circle><polyline
                    points='12 6 12 12 16 14'
                  ></polyline></svg>
                Prep:
                {{this.prep_time}}m
              </div>

              {{#if this.cooking_time}}
                <div class='info-badge'>
                  <svg class='icon' viewBox='0 0 24 24'><path
                      d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.1.2-2.2.5-3z'
                    ></path></svg>
                  Cuisson:
                  {{this.cooking_time}}m
                </div>
              {{/if}}

              <div class='info-badge'>
                <svg class='icon' viewBox='0 0 24 24'><path
                    d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'
                  ></path><circle cx='9' cy='7' r='4'></circle><path
                    d='M22 21v-2a4 4 0 0 0-3-3.87'
                  ></path><path d='M16 3.13a4 4 0 0 1 0 7.75'></path></svg>
                {{this.servings}}
                pers.
              </div>
            </div>
          </div>
        </header>

        <div class='content'>
          <aside class='ingredients'>
            <h2>
              <svg
                class='icon'
                style='width:16px; height:16px;'
                viewBox='0 0 24 24'
              ><path d='M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2'></path><path
                  d='M7 2v20'
                ></path><path
                  d='M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7'
                ></path></svg>
              Ingrédients
            </h2>
            <ul class='ing-list'>
              {{#each this.ingredients}}
                <li class='ing-item'>{{this}}</li>
              {{/each}}
            </ul>
          </aside>

          <main class='steps'>
            <h2>
              <svg
                class='icon'
                style='width:18px; height:18px;'
                viewBox='0 0 24 24'
              ><path
                  d='M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z'
                ></path><line x1='6' y1='17' x2='18' y2='17'></line></svg>
              Préparation
            </h2>
            <div class='steps-container'>
              {{#each this.steps}}
                <div class='step-item'>
                  <div class='step-number'></div>
                  <p class='step-text'>{{this}}</p>
                </div>
              {{/each}}
            </div>
          </main>
        </div>

        <div class='deco-circle'></div>
      </div>
    {{/each}}
  </body>
</html> --}}


