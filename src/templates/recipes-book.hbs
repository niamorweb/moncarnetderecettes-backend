<html>
  <head>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&family=Georgia:wght@900&display=swap');

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        -webkit-print-color-adjust: exact;
      }

      .recipe-page {
        width: 559px;
        height: 794px;
        padding: 30px;
        background-color: #fffbf0;
        color: #1a1a1a;
        font-family: serif;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;

        page-break-after: always;
        break-after: page;
      }

      .recipe-page:last-child {
        page-break-after: auto;
        break-after: auto;
      }

      .recipe-page::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url('https://www.transparenttextures.com/patterns/natural-paper.png');
        opacity: 0.4;
        pointer-events: none;
        z-index: 0;
      }

      .deco-circle {
        position: absolute;
        bottom: -20px;
        right: -20px;
        width: 100px;
        height: 100px;
        background-color: #ffd600;
        border-radius: 50%;
        opacity: 0.5;
        z-index: 0;
      }

      header {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
        align-items: flex-start;
        position: relative;
        z-index: 1;
      }

      .img-container {
        width: 220px;
        height: 240px;
        background-color: #ffffff;
        border: 2px solid #1a1a1a;
        box-shadow: 6px 6px 0px #1a1a1a;
        padding: 10px 10px 40px 10px;
        transform: rotate(-2deg);
        flex-shrink: 0;
        box-sizing: border-box;
      }

      .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: 1px solid #1a1a1a;
      }

      .header-content {
        flex: 1;
        padding-top: 10px;
      }

      .category-badge {
        background-color: #ffd600;
        padding: 4px 10px;
        font-size: 10px;
        font-weight: bold;
        border: 1.5px solid #1a1a1a;
        border-radius: 20px;
        text-transform: uppercase;
        font-family: 'Outfit', sans-serif;
        display: inline-block;
      }

      h1 {
        font-size: 32px;
        line-height: 1;
        margin: 15px 0;
        font-family: 'Georgia', serif;
        font-weight: 900;
      }

      .badges-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .info-badge {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: 'Outfit', sans-serif;
        font-size: 11px;
        font-weight: bold;
        background: white;
        padding: 5px 10px;
        border: 1.5px solid #1a1a1a;
        border-radius: 8px;
        white-space: nowrap;
      }

      .icon {
        width: 14px;
        height: 14px;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
      }

      .content {
        display: flex;
        gap: 25px;
        flex: 1;
        position: relative;
        z-index: 1;
      }

      aside.ingredients {
        width: 180px;
        background-color: #fff;
        border: 2px solid #1a1a1a;
        border-radius: 15px;
        padding: 15px;
        height: fit-content;
      }

      h2 {
        font-size: 16px;
        margin-top: 0;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
      }

      .ing-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-family: 'Outfit', sans-serif;
      }

      .ing-item {
        font-size: 11px;
        padding: 5px 0;
        border-bottom: 1px dashed #ccc;
        color: #444;
      }

      main.steps {
        flex: 1;
      }

      .steps-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
        counter-reset: step-counter;
      }

      .step-item {
        display: flex;
        gap: 15px;
      }

      .step-number {
        min-width: 28px;
        height: 28px;
        background-color: #f97316;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: bold;
        border: 2px solid #1a1a1a;
        flex-shrink: 0;
        font-family: 'Outfit', sans-serif;
      }

      .step-number::before {
        counter-increment: step-counter;
        content: counter(step-counter);
      }

      .step-text {
        font-size: 12px;
        margin: 0;
        line-height: 1.4;
        font-family: 'Outfit', sans-serif;
        color: #333;
        padding-top: 4px;
      }
    </style>
  </head>
  <body>
    {{#each recipes}}
      <div class='recipe-page'>
        <header>
          <div class='img-container'>
            <img src='{{this.image_url}}' alt='{{this.name}}' />
          </div>

          <div class='header-content'>
            <span class='category-badge'>{{this.category.name}}</span>
            <h1>{{this.name}}</h1>

            <div class='badges-row'>
              <div class='info-badge'>
                <svg class='icon' viewBox='0 0 24 24'><circle
                    cx='12'
                    cy='12'
                    r='10'
                  ></circle><polyline
                    points='12 6 12 12 16 14'
                  ></polyline></svg>
                Prep:
                {{this.prep_time}}m
              </div>

              {{#if this.cooking_time}}
                <div class='info-badge'>
                  <svg class='icon' viewBox='0 0 24 24'><path
                      d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.1.2-2.2.5-3z'
                    ></path></svg>
                  Cuisson:
                  {{this.cooking_time}}m
                </div>
              {{/if}}

              <div class='info-badge'>
                <svg class='icon' viewBox='0 0 24 24'><path
                    d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'
                  ></path><circle cx='9' cy='7' r='4'></circle><path
                    d='M22 21v-2a4 4 0 0 0-3-3.87'
                  ></path><path d='M16 3.13a4 4 0 0 1 0 7.75'></path></svg>
                {{this.servings}}
                pers.
              </div>
            </div>
          </div>
        </header>

        <div class='content'>
          <aside class='ingredients'>
            <h2>
              <svg
                class='icon'
                style='width:16px; height:16px;'
                viewBox='0 0 24 24'
              ><path d='M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2'></path><path
                  d='M7 2v20'
                ></path><path
                  d='M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7'
                ></path></svg>
              Ingrédients
            </h2>
            <ul class='ing-list'>
              {{#each this.ingredients}}
                <li class='ing-item'>{{this}}</li>
              {{/each}}
            </ul>
          </aside>

          <main class='steps'>
            <h2>
              <svg
                class='icon'
                style='width:18px; height:18px;'
                viewBox='0 0 24 24'
              ><path
                  d='M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z'
                ></path><line x1='6' y1='17' x2='18' y2='17'></line></svg>
              Préparation
            </h2>
            <div class='steps-container'>
              {{#each this.steps}}
                <div class='step-item'>
                  <div class='step-number'></div>
                  <p class='step-text'>{{this}}</p>
                </div>
              {{/each}}
            </div>
          </main>
        </div>

        <div class='deco-circle'></div>
      </div>
    {{/each}}
  </body>
</html>