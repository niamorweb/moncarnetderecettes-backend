{{!-- ========================================================================
     NOUVEAU CODE - Single page layout (image + ingredients card overlay)
     ======================================================================== --}}
<html>
  <head>
    <meta charset='utf-8' />
    <title>Mon Carnet de Recettes</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap');

      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* --- PAGE CONTAINER --- */
      .recipe-page {
        width: 148mm;
        height: 210mm;
        padding: 10mm;
        background-color: #ffffff;
        color: #1a1a1a;
        font-family: 'Playfair Display', serif;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
        page-break-after: always;
        break-after: page;
      }

      .recipe-page:last-child {
        page-break-after: auto;
        break-after: auto;
      }

      /* --- HEADER --- */
      .recipe-header {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-bottom: 4mm;
      }

      .recipe-title {
        font-family: 'Dancing Script', cursive;
        font-size: 36px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 1;
        color: #000;
        margin: 2mm 0 0 0;
        text-align: right;
      }

      .recipe-meta {
        display: flex;
        gap: 6mm;
        align-items: center;
        margin-top: 2mm;
        margin-bottom: 1mm;
        font-family: 'Playfair Display', serif;
        font-size: 11px;
        color: #1f2937;
      }

      .meta-item {
        display: flex;
        align-items: center;
        gap: 2mm;
      }

      .meta-icon {
        width: 14px;
        height: 14px;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
      }

      /* --- IMAGE SECTION --- */
      .image-section {
        position: relative;
        width: 100%;
        margin-bottom: 6mm;
      }

      .image-container {
        width: 100%;
        height: 55mm;
        overflow: hidden;
        border-radius: 8mm;
      }

      .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .no-image-placeholder {
        width: 100%;
        height: 100%;
        background-color: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-style: italic;
        color: #9ca3af;
        font-size: 12px;
      }

      /* --- INGREDIENTS CARD (overlay) --- */
      .ingredients-card {
        position: absolute;
        right: 0;
        top: 38mm;
        width: 42mm;
        background-color: #f2eeeb;
        border-radius: 5mm;
        padding: 4mm 5mm;
        z-index: 10;
      }

      .ingredients-title {
        font-family: 'Dancing Script', cursive;
        font-weight: 700;
        font-size: 18px;
        margin: 0 0 3mm 0;
        letter-spacing: 0.05em;
      }

      .ingredients-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-family: 'Playfair Display', serif;
        font-size: 10px;
        color: #1f2937;
        line-height: 1.4;
      }

      .ingredients-list li {
        margin-bottom: 1.5mm;
      }

      /* --- DIRECTIONS --- */
      .directions-section {
        padding-top: 2mm;
      }

      .directions-title {
        font-family: 'Dancing Script', cursive;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 3mm 0;
        letter-spacing: 0.05em;
      }

      .steps-list {
        counter-reset: step-counter;
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .steps-list li {
        position: relative;
        padding-left: 5mm;
        margin-bottom: 2mm;
        font-size: 10px;
        line-height: 1.5;
        color: #1f2937;
        counter-increment: step-counter;
      }

      .steps-list li::before {
        content: counter(step-counter) '.';
        position: absolute;
        left: 0;
        top: 0;
        font-weight: 700;
      }

      /* --- FOOTER --- */
      .recipe-footer {
        position: absolute;
        bottom: 5mm;
        left: 10mm;
        right: 10mm;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 2mm;
        border-top: 1px solid #d1d5db;
        font-family: monospace;
      }

      .footer-label {
        font-size: 8px;
        color: #9ca3af;
      }

      .footer-page {
        font-size: 9px;
        font-weight: bold;
        color: #4b5563;
      }
    </style>
  </head>
  <body>
    {{#each recipes}}
      <div class='recipe-page'>

        {{!-- HEADER --}}
        <div class='recipe-header'>
          <h1 class='recipe-title'>{{this.name}}</h1>
          <div class='recipe-meta'>
            <div class='meta-item'>
              <svg class='meta-icon' viewBox='0 0 24 24'>
                <path d='M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z' />
              </svg>
              <span>{{this.servings}} pers.</span>
            </div>
            <div class='meta-item'>
              <svg class='meta-icon' viewBox='0 0 24 24'>
                <path d='M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' />
              </svg>
              <span>{{this.prep_time}} min</span>
            </div>
          </div>
        </div>

        {{!-- IMAGE + INGREDIENTS OVERLAY --}}
        <div class='image-section'>
          <div class='image-container'>
            {{#if this.image_url}}
              <img src='{{this.image_url}}' alt='{{this.name}}' />
            {{else}}
              <div class='no-image-placeholder'>Aucune illustration</div>
            {{/if}}
          </div>

          <div class='ingredients-card'>
            <h3 class='ingredients-title'>Ingrédients</h3>
            <ul class='ingredients-list'>
              {{#each this.ingredients}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        {{!-- DIRECTIONS --}}
        <div class='directions-section'>
          <h2 class='directions-title'>Préparation</h2>
          <ol class='steps-list'>
            {{#each this.steps}}
              <li>{{this}}</li>
            {{/each}}
          </ol>
        </div>

        {{!-- FOOTER --}}
        <div class='recipe-footer'>
          <span class='footer-label'>Mon Carnet de Recettes</span>
          <span class='footer-page'>{{calcPageSingle @index}}</span>
        </div>

      </div>
    {{/each}}
  </body>
</html>
